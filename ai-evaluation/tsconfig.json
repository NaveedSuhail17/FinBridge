{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": "..",
    "paths": {
      "@anthropic-ai/sdk": ["node_modules/@anthropic-ai/sdk"],
      "zod": ["node_modules/zod"]
    },
    "types": ["node"],
    "outDir": "./dist"
  },
  "include": ["./**/*.ts"],
  "exclude": ["dist"]
}
