# ── Stage 1: deps ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps
WORKDIR /app

RUN npm install -g pnpm@11.1.2

COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY package.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/config/package.json ./packages/config/
COPY packages/types/package.json ./packages/types/
COPY packages/prompts/package.json ./packages/prompts/

RUN pnpm install --frozen-lockfile --filter @finbridge/api...

# ── Stage 2: builder ──────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

RUN npm install -g pnpm@11.1.2

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY . .

# Build workspace packages first, then the API
RUN pnpm --filter @finbridge/prompts build
RUN pnpm --filter @finbridge/api build

# Produce a standalone deployment folder with all node_modules resolved (no symlinks)
RUN pnpm --filter @finbridge/api deploy --prod --legacy /tmp/api-deploy

# ── Stage 3: runner ───────────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

COPY --from=builder --chown=nestjs:nodejs /app/apps/api/dist ./dist
COPY --from=builder --chown=nestjs:nodejs /tmp/api-deploy/node_modules ./node_modules
RUN mkdir -p uploads && chown nestjs:nodejs uploads

USER nestjs
EXPOSE 3001

CMD ["node", "dist/apps/api/src/main"]
