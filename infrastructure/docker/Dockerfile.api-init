# ── FinBridge API Init Container ────────────────────────────────────────────────
# Runs schema:sync + seed before the production API starts.
# Used by docker-compose.yml as the `api-init` service.
FROM node:22-alpine

WORKDIR /app

RUN npm install -g pnpm

# ── Install deps (same filter as prod api stage) ─────────────────────────────
COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./
COPY package.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/config/package.json ./packages/config/
COPY packages/types/package.json ./packages/types/
COPY packages/prompts/package.json ./packages/prompts/

RUN pnpm install --frozen-lockfile --filter @finbridge/api...

# ── Copy source files needed for ts-node execution ───────────────────────────
COPY apps/api/src ./apps/api/src
COPY apps/api/tsconfig.json ./apps/api/
COPY apps/api/tsconfig.typeorm.json ./apps/api/
COPY packages/config ./packages/config
COPY packages/types ./packages/types
COPY packages/prompts ./packages/prompts

# DATABASE_URL injected by docker-compose environment block at runtime.
# dotenv.config() in data-source.ts and seed.ts is a no-op when the var is preset.

CMD ["sh", "-c", "pnpm --filter @finbridge/api db:schema:sync && pnpm --filter @finbridge/api db:seed"]
